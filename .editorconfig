root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csproj,sln}]
# Use spaces, 4 columns
indent_style = space
indent_size = 4

[*.cs]
# Prefer var for built-in types and when type is apparent; explicit otherwise
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Do not require qualification (this.) for members
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Braces, new lines and formatting
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all:warning
csharp_indent_switch_labels = true
csharp_preserve_single_line_blocks = false

# Treat generated files as generated
generated_code = true